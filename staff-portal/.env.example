# Copy to a root-protected production env file; never commit populated values.
# Keep PostgreSQL on loopback when it shares this VPS. Use DATABASE_SSL=verify-full
# only when a trusted CA certificate is configured for a remote PostgreSQL server.
DATABASE_URL=postgresql://ksl_runtime:REPLACE_WITH_PASSWORD@127.0.0.1:5432/ksl
DATABASE_POOL_MAX=10
DATABASE_SSL=disable

# Private filesystem storage, outside the application and all public web roots.
STORAGE_DIR=/var/lib/ksl-portal/files

# Generate each secret independently with: openssl rand -base64 48
STORED_FILE_SIGNING_SECRET=
CONTACT_TOKEN_SECRET=
MESSAGE_VIEW_UNLOCK_SECRET=

# --- Origins (no trailing slash) ---
# Stage 1: public site + portal only on ports 80/443 (Nginx).
# Portal Node listens on 127.0.0.1:3000; Nginx proxies /admin (do not open :3000).
# Or run: bash deploy/vps/fill-ip.sh --http YOUR_VPS_IP
#
# Later (TLS + real hostname), switch to HTTPS origins and rebuild.
# Do not require kenyashipyards.co.ke until that hostname points at this VPS.
NEXT_PUBLIC_BASE_PATH=/admin
NEXT_PUBLIC_PORTAL_URL=http://178.162.219.218/admin
NEXT_PUBLIC_SITE_URL=http://178.162.219.218
PUBLIC_SITE_ORIGIN=http://178.162.219.218

# Turnstile can be left empty for private IP smoke tests; enable before public launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TRUSTED_PROXY_HOPS=0
NODE_ENV=production
