# Copy to .env.production on the VPS. Do not commit the filled file.
# No quotes. No spaces around =. No trailing slash on a URL.
# Supabase stays the database and the staff login. These values point at the
# existing project. They do not create a new one.

NEXT_PUBLIC_SUPABASE_URL=https://envqgczfhxywkxcnsxrt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opening a contact message uses this. The Vercel project stores it as SUPABASE_JWT_SECRET.
SUPABASE_JWT_SECRET=

# Fill these when you know the server IP. bash deploy/vps/fill-ip.sh does it.
# Portal is https://IP:8443 and the public site is https://IP
NEXT_PUBLIC_PORTAL_URL=
NEXT_PUBLIC_SITE_URL=
PUBLIC_SITE_ORIGIN=

# Required behind Nginx so sign-in lockouts see the visitor IP.
TRUSTED_PROXY_HOPS=1
NODE_ENV=production
