# Copy to a root-protected production env file; never commit populated values.
# Keep PostgreSQL on loopback when it shares this VPS. Use DATABASE_SSL=verify-full
# only when a trusted CA certificate is configured for a remote PostgreSQL server.
DATABASE_URL=postgresql://ksl_runtime:REPLACE_WITH_PASSWORD@127.0.0.1:5432/ksl
DATABASE_POOL_MAX=10
DATABASE_SSL=disable

# Private filesystem storage, outside the application and all public web roots.
STORAGE_DIR=/var/lib/ksl-portal/files

# Generate each secret independently with: openssl rand -base64 48
STORED_FILE_SIGNING_SECRET=
CONTACT_TOKEN_SECRET=
MESSAGE_VIEW_UNLOCK_SECRET=

# Public origins; no trailing slash. PUBLIC_SITE_ORIGIN accepts comma-separated origins.
NEXT_PUBLIC_PORTAL_URL=https://portal.example.co.ke
NEXT_PUBLIC_SITE_URL=https://www.kenyashipyards.co.ke
PUBLIC_SITE_ORIGIN=https://www.kenyashipyards.co.ke,https://kenyashipyards.co.ke

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TRUSTED_PROXY_HOPS=1
NODE_ENV=production
